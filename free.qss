/* ===== 暖意番茄主题 (自由模式 - 晴空湛蓝心流风) ===== */

/* 主窗口背景 */
QDialog#TimerWindow {
    background-color: #f6f9fe;
    font-family: 'Microsoft YaHei UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
    color: #1e293b;
}

/* 顶部模式切换胶囊按钮 */
QPushButton#modeCapsule {
    background-color: #e6f0fe;
    border: 1px solid #c3dbfc;
    border-radius: 19px;
    padding: 0px 4px;
    outline: none;
}
QPushButton#modeCapsule:hover {
    background-color: #d7e7fd;
    border-color: #9dc5fa;
}
QPushButton#modeCapsule:pressed {
    background-color: #c4dcfa;
}

/* 顶部圆形工具按钮（时间轴/设置/更多） */
QPushButton#timelineButton, QPushButton#settingsButton, QPushButton#moreButton {
    background-color: #ffffff;
    border: 1px solid #e6eef8;
    border-radius: 22px;
    min-width: 44px;
    min-height: 44px;
    max-width: 44px;
    max-height: 44px;
    padding: 0px;
    outline: none;
}
QPushButton#timelineButton:hover, QPushButton#settingsButton:hover, QPushButton#moreButton:hover {
    background-color: #fafafa;
    border-color: #cfdced;
}
QPushButton#timelineButton:pressed, QPushButton#settingsButton:pressed, QPushButton#moreButton:pressed {
    background-color: #edf2f7;
}

/* 隐藏更多按钮默认自带的下拉指示箭头 */
QPushButton#moreButton::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
}

/* 更多操作菜单 */
QMenu#more_menu {
    background-color: #ffffff;
    border: 1.5px solid #dce9fa;
    border-radius: 14px;
    padding: 8px 0;
}
QMenu#more_menu::item {
    padding: 10px 28px;
    color: #1e293b;
    font-size: 14px;
    font-weight: 600;
}
QMenu#more_menu::item:selected {
    background: #e6f0fe;
    color: #1d4ed8;
}
QMenu#more_menu::separator {
    height: 1px;
    background: #e2ecf9;
    margin: 6px 12px;
}

/* 时间显示容器 */
#timerDisplayWidget {
    background-color: transparent;
    border: none;
}
#timerContainer {
    background-color: transparent;
}

/* 中部并列白色信息卡片 */
QWidget#infoCard {
    background-color: #ffffff;
    border: 1px solid #e6eef8;
    border-radius: 18px;
}

/* 开始专注大蓝渐变胶囊主按钮 */
QPushButton#startButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3b82f6, stop:1 #2563eb);
    border: none;
    border-radius: 28px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.8px;
    min-height: 56px;
    outline: none;
}
QPushButton#startButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #60a5fa, stop:1 #3b82f6);
}
QPushButton#startButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1d4ed8, stop:1 #1e40af);
}

/* 结束任务白底旗帜胶囊次按钮 */
QPushButton#finishButton {
    background-color: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 28px;
    color: #1e293b;
    font-size: 15px;
    font-weight: 700;
    min-height: 56px;
    outline: none;
}
QPushButton#finishButton:hover {
    background-color: #fdfdfd;
    border-color: #cbd5e1;
}
QPushButton#finishButton:pressed {
    background-color: #f1f5f9;
}

/* 底部次要操作微提示 */
QLabel#secondaryInfoLabel {
    color: #8b9ab0;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

/* 弹窗与消息提示框 (QMessageBox) */
QMessageBox {
    background-color: #ffffff;
    border: 2px solid #3b82f6;
    border-radius: 14px;
}
QMessageBox QLabel {
    color: #1e293b;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    background: transparent;
    min-height: 40px;
    padding: 6px;
}
QMessageBox QPushButton {
    padding: 8px 24px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3b82f6, stop:1 #2563eb);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    min-width: 75px;
    min-height: 24px;
}
QMessageBox QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #60a5fa, stop:1 #3b82f6);
}
QMessageBox QPushButton:pressed {
    background: #1d4ed8;
}
QMessageBox QPushButton[text="No"], 
QMessageBox QPushButton[text="否"], 
QMessageBox QPushButton[text="取消"], 
QMessageBox QPushButton[text="Cancel"] {
    background: #f6f8fa;
    color: #24292f;
    border: 1.5px solid #d0d7de;
}
QMessageBox QPushButton[text="No"]:hover, 
QMessageBox QPushButton[text="否"]:hover, 
QMessageBox QPushButton[text="取消"]:hover, 
QMessageBox QPushButton[text="Cancel"]:hover {
    background: #e8eaed;
    border-color: #afb8c1;
}

/* 通用工具提示 (QToolTip) */
QToolTip {
    background-color: #1e293b;
    color: #ffffff;
    border: 1.5px solid #3b82f6;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-weight: 500;
}
