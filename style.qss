/*
 * ═══════════════════════════════════════════════════════════════
 * 番茄钟样式表 - 清新自然主义设计
 * Fresh Naturalism: 清新白绿 · 自然呼吸 · 专注时光
 * ═══════════════════════════════════════════════════════════════
 */

/* ───────────────────────────────────────────────────────────────
   专注模式样式 - 清新白绿（自然呼吸）
   Focus Mode: Fresh Natural Green
   ─────────────────────────────────────────────────────────────── */
FOCUS_STYLE = """
/* ===== 主窗口背景 ===== */
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f5fcf8, stop:0.5 #f0fbf6, stop:1 #e8f9f0);
    font-family: 'Microsoft YaHei UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
    color: #1b4332;
}

/* ===== 模式标签 ===== */
#mode_label {
    color: #1b4332;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 12px 24px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0.15), stop:1 rgba(69, 179, 144, 0.15));
    border-radius: 24px;
    border: 2px solid rgba(78, 204, 163, 0.3);
}

/* ===== 顶部按钮（设置/更多）===== */
#settingsButton, #moreButton {
    background-color: rgba(255, 255, 255, 0.85);
    border: 2px solid rgba(78, 204, 163, 0.25);
    border-radius: 24px;
    color: #1b4332;
    font-size: 20px;
    font-weight: bold;
    padding: 8px;
    min-width: 40px;
    min-height: 40px;
}
#settingsButton:hover, #moreButton:hover {
    background-color: rgba(255, 255, 255, 1);
    border-color: rgba(78, 204, 163, 0.5);
}
#settingsButton:pressed, #moreButton:pressed {
    background-color: rgba(255, 255, 255, 0.7);
}

/* ===== 更多菜单样式 ===== */
QMenu#more_menu {
    background-color: rgba(255, 255, 255, 0.98);
    border: 2px solid rgba(78, 204, 163, 0.3);
    border-radius: 12px;
    padding: 8px 0;
}
QMenu#more_menu::item {
    padding: 12px 32px;
    color: #1b4332;
    font-size: 14px;
    font-weight: 600;
}
QMenu#more_menu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0.2), stop:1 rgba(69, 179, 144, 0.2));
}
QMenu#more_menu::separator {
    height: 1px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0), stop:0.5 rgba(78, 204, 163, 0.3), stop:1 rgba(78, 204, 163, 0));
    margin: 6px 12px;
}

/* ===== 时间显示容器 ===== */
#timerDisplayWidget {
    background-color: transparent;
    border: none;
}
#timerContainer {
    background-color: transparent;
}

/* ===== 今日专注时长标签 ===== */
#timer_duration_laber {
    color: #1b4332;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.6);
    border-radius: 16px;
    border: 1px solid rgba(78, 204, 163, 0.2);
}

/* ===== 循环次数标签 ===== */
#cycle_label {
    color: #2d5a45;
    font-size: 15px;
    font-weight: 700;
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.6);
    border-radius: 16px;
    border: 1px solid rgba(78, 204, 163, 0.2);
}

/* ===== 次要信息标签 ===== */
#secondaryInfoLabel {
    color: #406b52;
    font-size: 13px;
    font-weight: 600;
}

/* ===== 开始/暂停按钮（主按钮）===== */
#startButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4ecca3, stop:1 #45b390);
    border: 3px solid #5ddbb9;
    padding: 20px 40px;
    border-radius: 36px;
    color: #ffffff;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1.2px;
}
#startButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5ddbb9, stop:1 #4ecca3);
    border-color: #6eebd0;
}
#startButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3db38a, stop:1 #349571);
    border-color: #3db38a;
}

/* ===== 结束任务按钮（次主按钮）===== */
#finishButton {
    background-color: rgba(255, 255, 255, 0.9);
    border: 3px solid rgba(78, 204, 163, 0.4);
    padding: 20px 32px;
    border-radius: 36px;
    color: #1b4332;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.8px;
}
#finishButton:hover {
    background-color: rgba(255, 255, 255, 1);
    border-color: rgba(78, 204, 163, 0.6);
}
#finishButton:pressed {
    background-color: rgba(255, 255, 255, 0.7);
    border-color: rgba(78, 204, 163, 0.3);
}
"""

/* ───────────────────────────────────────────────────────────────
   休息模式样式 - 温柔浅绿（放松呼吸）
   Relax Mode: Gentle Light Green
   ─────────────────────────────────────────────────────────────── */
RELAX_STYLE = """
/* ===== 主窗口背景 ===== */
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #e8f5e9, stop:0.5 #f1f8f3, stop:1 #f0fbf6);
    font-family: 'Microsoft YaHei UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
    color: #2e7d32;
}

/* ===== 模式标签 ===== */
#mode_label {
    color: #2e7d32;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 12px 24px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(129, 199, 132, 0.2), stop:1 rgba(102, 187, 106, 0.2));
    border-radius: 24px;
    border: 2px solid rgba(102, 187, 106, 0.4);
}

/* ===== 顶部按钮 ===== */
#settingsButton, #moreButton {
    background-color: rgba(255, 255, 255, 0.9);
    border: 2px solid rgba(102, 187, 106, 0.35);
    border-radius: 24px;
    color: #2e7d32;
    font-size: 20px;
    font-weight: bold;
    padding: 8px;
    min-width: 40px;
    min-height: 40px;
}
#settingsButton:hover, #moreButton:hover {
    background-color: rgba(255, 255, 255, 1);
    border-color: rgba(102, 187, 106, 0.6);
}
#settingsButton:pressed, #moreButton:pressed {
    background-color: rgba(255, 255, 255, 0.75);
}

/* ===== 更多菜单样式 ===== */
QMenu#more_menu {
    background-color: rgba(255, 255, 255, 0.98);
    border: 2px solid rgba(102, 187, 106, 0.35);
    border-radius: 12px;
    padding: 8px 0;
}
QMenu#more_menu::item {
    padding: 12px 32px;
    color: #2e7d32;
    font-size: 14px;
    font-weight: 600;
}
QMenu#more_menu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(102, 187, 106, 0.25), stop:1 rgba(129, 199, 132, 0.25));
}
QMenu#more_menu::separator {
    height: 1px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(102, 187, 106, 0), stop:0.5 rgba(102, 187, 106, 0.35), stop:1 rgba(102, 187, 106, 0));
    margin: 6px 12px;
}

/* ===== 时间显示容器 ===== */
#timerDisplayWidget, #timerContainer {
    background-color: transparent;
    border: none;
}

/* ===== 信息标签 ===== */
#timer_duration_laber {
    color: #2e7d32;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    border: 1px solid rgba(102, 187, 106, 0.25);
}
#cycle_label {
    color: #388e3c;
    font-size: 15px;
    font-weight: 700;
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    border: 1px solid rgba(102, 187, 106, 0.25);
}
#secondaryInfoLabel {
    color: #43a047;
    font-size: 13px;
    font-weight: 600;
}

/* ===== 开始/暂停按钮 ===== */
#startButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #81c784, stop:1 #66bb6a);
    border: 3px solid #a5d6a7;
    padding: 20px 40px;
    border-radius: 36px;
    color: #ffffff;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1.2px;
}
#startButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a5d6a7, stop:1 #81c784);
    border-color: #c8e6c9;
}
#startButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #66bb6a, stop:1 #4caf50);
    border-color: #66bb6a;
}

/* ===== 结束任务按钮 ===== */
#finishButton {
    background-color: rgba(255, 255, 255, 0.95);
    border: 3px solid rgba(102, 187, 106, 0.5);
    padding: 20px 32px;
    border-radius: 36px;
    color: #2e7d32;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.8px;
}
#finishButton:hover {
    background-color: rgba(255, 255, 255, 1);
    border-color: rgba(102, 187, 106, 0.7);
}
#finishButton:pressed {
    background-color: rgba(255, 255, 255, 0.8);
    border-color: rgba(102, 187, 106, 0.4);
}
"""

/* ───────────────────────────────────────────────────────────────
   设置对话框样式 - 清新现代
   Settings Dialog: Fresh Modern
   ─────────────────────────────────────────────────────────────── */
SETTINGS_STYLE = """
/* ===== 对话框整体背景 ===== */
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f5fcf8, stop:0.5 #f0fbf6, stop:1 #ffffff);
}

/* ===== 分组框 ===== */
QGroupBox {
    font-weight: 700;
    font-size: 15px;
    color: #1b4332;
    border: 2px solid rgba(78, 204, 163, 0.3);
    border-radius: 12px;
    margin-top: 24px;
    padding: 20px 16px 16px 16px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.9), stop:1 rgba(240, 251, 246, 0.8));
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 18px;
    padding: 0 12px;
    margin-top: -8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0.15), stop:1 rgba(69, 179, 144, 0.15));
    border-radius: 8px;
    border: 1px solid rgba(78, 204, 163, 0.25);
}

/* ===== 标签 ===== */
QLabel {
    color: #1b4332;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

/* ===== 数字输入框 ===== */
QSpinBox {
    padding: 8px 14px;
    border: 2px solid rgba(78, 204, 163, 0.3);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.95);
    color: #1b4332;
    font-size: 14px;
    font-weight: 600;
    min-width: 120px;
    min-height: 36px;
}
QSpinBox:focus {
    border: 2px solid #4ecca3;
    background: rgba(255, 255, 255, 1);
}
QSpinBox:hover {
    border: 2px solid rgba(78, 204, 163, 0.5);
}
/* 上下按钮样式 */
QSpinBox::up-button, QSpinBox::down-button {
    width: 24px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(78, 204, 163, 0.15), stop:1 rgba(69, 179, 144, 0.15));
    border: none;
    border-radius: 4px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(78, 204, 163, 0.3), stop:1 rgba(69, 179, 144, 0.3));
}

/* ===== 滑块 ===== */
QSlider::groove:horizontal {
    height: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0.2), stop:1 rgba(69, 179, 144, 0.2));
    border-radius: 4px;
}
QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4ecca3, stop:1 #45b390);
    border: 2px solid #5ddbb9;
    border-radius: 10px;
    margin: -6px 0;
}
QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #5ddbb9, stop:1 #4ecca3);
}

/* ===== 复选框 ===== */
QCheckBox {
    font-size: 14px;
    color: #1b4332;
    font-weight: 600;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(78, 204, 163, 0.4);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.9);
}
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4ecca3, stop:1 #45b390);
    border-color: #4ecca3;
}
QCheckBox::indicator:hover {
    border-color: rgba(78, 204, 163, 0.6);
}

/* ===== 底部按钮 ===== */
QPushButton {
    padding: 10px 28px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.5px;
}
#saveButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4ecca3, stop:1 #45b390);
    color: white;
    border: 2px solid #4ecca3;
}
#saveButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5ddbb9, stop:1 #4ecca3);
    border-color: #5ddbb9;
}
#saveButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3db38a, stop:1 #349571);
}
#cancelButton {
    background: rgba(255, 255, 255, 0.9);
    color: #1b4332;
    border: 2px solid rgba(78, 204, 163, 0.35);
}
#cancelButton:hover {
    background: rgba(255, 255, 255, 1);
    border-color: rgba(78, 204, 163, 0.55);
}
#cancelButton:pressed {
    background: rgba(255, 255, 255, 0.75);
    border-color: rgba(78, 204, 163, 0.25);
}
"""
