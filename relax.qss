/* ===== 暖意番茄主题 (休息模式 - 舒缓温润蜜糖暖橙) ===== */

/* 主窗口背景 */
QDialog#TimerWindow {
    background-color: #fbf8f5;
    font-family: 'Microsoft YaHei UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
    color: #451a03;
}

/* 顶部模式切换胶囊按钮 */
QPushButton#modeCapsule {
    background-color: #fef3e6;
    border: 1px solid #fedbb3;
    border-radius: 19px;
    padding: 0px 4px;
    outline: none;
}
QPushButton#modeCapsule:hover {
    background-color: #feead0;
    border-color: #fcc282;
}
QPushButton#modeCapsule:pressed {
    background-color: #fdddb3;
}

/* 顶部圆形工具按钮（设置/更多） */
QPushButton#settingsButton, QPushButton#moreButton {
    background-color: #ffffff;
    border: 1px solid #f5ede6;
    border-radius: 22px;
    min-width: 44px;
    min-height: 44px;
    max-width: 44px;
    max-height: 44px;
    padding: 0px;
    outline: none;
}
QPushButton#settingsButton:hover, QPushButton#moreButton:hover {
    background-color: #fafafa;
    border-color: #e8ded6;
}
QPushButton#settingsButton:pressed, QPushButton#moreButton:pressed {
    background-color: #f0ece9;
}

/* 隐藏更多按钮默认自带的下拉指示箭头 */
QPushButton#moreButton::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
}

/* 更多操作菜单 */
QMenu#more_menu {
    background-color: #ffffff;
    border: 1.5px solid #fae8d7;
    border-radius: 14px;
    padding: 8px 0;
}
QMenu#more_menu::item {
    padding: 10px 28px;
    color: #451a03;
    font-size: 14px;
    font-weight: 600;
}
QMenu#more_menu::item:selected {
    background: #fef3e6;
    color: #b45309;
}
QMenu#more_menu::separator {
    height: 1px;
    background: #f7e6d2;
    margin: 6px 12px;
}

/* 时间显示容器 */
#timerDisplayWidget {
    background-color: transparent;
    border: none;
}
#timerContainer {
    background-color: transparent;
}

/* 中部并列白色信息卡片 */
QWidget#infoCard {
    background-color: #ffffff;
    border: 1px solid #f5ede6;
    border-radius: 18px;
}

/* 开始专注/休息大钮（暖橙渐变） */
QPushButton#startButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f59e0b, stop:1 #d97706);
    border: none;
    border-radius: 28px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.8px;
    min-height: 56px;
    outline: none;
}
QPushButton#startButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fbbf24, stop:1 #f59e0b);
}
QPushButton#startButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #b45309, stop:1 #92400e);
}

/* 结束任务白底旗帜胶囊次按钮 */
QPushButton#finishButton {
    background-color: #ffffff;
    border: 1.5px solid #eee5dc;
    border-radius: 28px;
    color: #451a03;
    font-size: 15px;
    font-weight: 700;
    min-height: 56px;
    outline: none;
}
QPushButton#finishButton:hover {
    background-color: #fdfdfd;
    border-color: #ded1c4;
}
QPushButton#finishButton:pressed {
    background-color: #f4eee9;
}

/* 底部次要操作微提示 */
QLabel#secondaryInfoLabel {
    color: #a89a90;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

/* 弹窗与消息提示框 (QMessageBox) */
QMessageBox {
    background-color: #ffffff;
    border: 2px solid #f59e0b;
    border-radius: 14px;
}
QMessageBox QLabel {
    color: #451a03;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    background: transparent;
    min-height: 40px;
    padding: 6px;
}
QMessageBox QPushButton {
    padding: 8px 24px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f59e0b, stop:1 #d97706);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    min-width: 75px;
    min-height: 24px;
}
QMessageBox QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fbbf24, stop:1 #f59e0b);
}
QMessageBox QPushButton:pressed {
    background: #b45309;
}
QMessageBox QPushButton[text="No"], 
QMessageBox QPushButton[text="否"], 
QMessageBox QPushButton[text="取消"], 
QMessageBox QPushButton[text="Cancel"] {
    background: #f6f8fa;
    color: #24292f;
    border: 1.5px solid #d0d7de;
}
QMessageBox QPushButton[text="No"]:hover, 
QMessageBox QPushButton[text="否"]:hover, 
QMessageBox QPushButton[text="取消"]:hover, 
QMessageBox QPushButton[text="Cancel"]:hover {
    background: #e8eaed;
    border-color: #afb8c1;
}

/* 通用工具提示 (QToolTip) */
QToolTip {
    background-color: #451a03;
    color: #ffffff;
    border: 1.5px solid #f59e0b;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-weight: 500;
}
