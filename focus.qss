/* ===== 主窗口背景 ===== */
QDialog#TimerWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f5fcf8, stop:0.5 #f0fbf6, stop:1 #e8f9f0);
    font-family: 'Microsoft YaHei UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
    color: #1b4332;
}

/* ===== 模式标签 ===== */
#mode_label {
    color: #1b4332;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 12px 24px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0.15), stop:1 rgba(69, 179, 144, 0.15));
    border-radius: 24px;
    border: 2px solid rgba(78, 204, 163, 0.3);
}

/* ===== 顶部按钮（设置/更多）===== */
#settingsButton, #moreButton {
    background-color: rgba(255, 255, 255, 0.85);
    border: 2px solid rgba(78, 204, 163, 0.25);
    border-radius: 22px;
    color: #1b4332;
    font-size: 20px;
    font-weight: bold;
    padding: 8px;
    min-width: 40px;
    min-height: 40px;
}
#settingsButton:hover, #moreButton:hover {
    background-color: rgba(255, 255, 255, 1);
    border-color: rgba(78, 204, 163, 0.5);
}
#settingsButton:pressed, #moreButton:pressed {
    background-color: rgba(255, 255, 255, 0.7);
}

/* 隐藏更多按钮默认自带的黑色下拉箭头 */
#moreButton::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
}

/* ===== 更多菜单样式 ===== */
QMenu#more_menu {
    background-color: rgba(255, 255, 255, 0.98);
    border: 2px solid rgba(78, 204, 163, 0.3);
    border-radius: 12px;
    padding: 8px 0;
}
QMenu#more_menu::item {
    padding: 12px 32px;
    color: #1b4332;
    font-size: 14px;
    font-weight: 600;
}
QMenu#more_menu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0.2), stop:1 rgba(69, 179, 144, 0.2));
}
QMenu#more_menu::separator {
    height: 1px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0), stop:0.5 rgba(78, 204, 163, 0.3), stop:1 rgba(78, 204, 163, 0));
    margin: 6px 12px;
}

/* ===== 时间显示容器 ===== */
#timerDisplayWidget {
    background-color: transparent;
    border: none;
}
#timerContainer {
    background-color: transparent;
}

/* ===== 今日专注时长标签 ===== */
#timer_duration_laber {
    color: #1b4332;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 16px;
    border: 1px solid rgba(78, 204, 163, 0.3);
}

/* ===== 循环次数标签 ===== */
#cycle_label {
    color: #1b4332;
    font-size: 15px;
    font-weight: 700;
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.75);
    border-radius: 16px;
    border: 1px solid rgba(78, 204, 163, 0.3);
}

/* ===== 次要信息标签 ===== */
#secondaryInfoLabel {
    color: #244b36;
    font-size: 13px;
    font-weight: 600;
}

/* ===== 开始/暂停按钮（主按钮）===== */
#startButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4ecca3, stop:1 #45b390);
    border: 3px solid #5ddbb9;
    padding: 20px 40px;
    border-radius: 34px;
    color: #ffffff;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1.2px;
}
#startButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5ddbb9, stop:1 #4ecca3);
    border-color: #6eebd0;
}
#startButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3db38a, stop:1 #349571);
    border-color: #3db38a;
}

/* ===== 结束任务按钮（次主按钮）===== */
#finishButton {
    background-color: rgba(255, 255, 255, 0.95);
    border: 2.5px solid rgba(78, 204, 163, 0.5);
    padding: 20px 32px;
    border-radius: 34px;
    color: #1b4332;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.8px;
}
#finishButton:hover {
    background-color: rgba(255, 255, 255, 1);
    border-color: rgba(78, 204, 163, 0.75);
}
#finishButton:pressed {
    background-color: rgba(255, 255, 255, 0.8);
    border-color: rgba(78, 204, 163, 0.35);
}

/* ===== 弹窗与消息提示框 (QMessageBox) ===== */
QMessageBox {
    background-color: #ffffff;
    border: 2px solid #4ecca3;
    border-radius: 14px;
}
QMessageBox QLabel {
    color: #1b4332;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    background: transparent;
    min-height: 40px;
    padding: 6px;
}
QMessageBox QPushButton {
    padding: 8px 24px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4ecca3, stop:1 #45b390);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    min-width: 75px;
    min-height: 24px;
}
QMessageBox QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5ddbb9, stop:1 #4ecca3);
}
QMessageBox QPushButton:pressed {
    background: #3db38a;
}
QMessageBox QPushButton[text="No"], 
QMessageBox QPushButton[text="否"], 
QMessageBox QPushButton[text="取消"], 
QMessageBox QPushButton[text="Cancel"] {
    background: #f6f8fa;
    color: #24292f;
    border: 1.5px solid #d0d7de;
}
QMessageBox QPushButton[text="No"]:hover, 
QMessageBox QPushButton[text="否"]:hover, 
QMessageBox QPushButton[text="取消"]:hover, 
QMessageBox QPushButton[text="Cancel"]:hover {
    background: #e8eaed;
    border-color: #afb8c1;
}

/* ===== 通用工具提示 (QToolTip) ===== */
QToolTip {
    background-color: #1b4332;
    color: #ffffff;
    border: 1.5px solid #4ecca3;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-weight: 500;
}
