/* ===== 对话框整体背景 ===== */
QDialog#SettingsDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f5fcf8, stop:0.5 #f0fbf6, stop:1 #ffffff);
}

/* ===== 选项卡面板 ===== */
QTabWidget::pane {
    border: 2px solid rgba(78, 204, 163, 0.3);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.96);
    top: -2px;
}
QTabWidget > QWidget {
    background: rgba(255, 255, 255, 0.96);
    border-radius: 12px;
}
QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f6f8fa, stop:1 #eef2f5);
    border: 2px solid rgba(78, 204, 163, 0.25);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 16px;
    margin-right: 4px;
    color: #406b52;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.96);
    border-color: rgba(78, 204, 163, 0.3);
    border-bottom: transparent;
    color: #1b4332;
    font-weight: 700;
}
QTabBar::tab:hover {
    background: #ffffff;
    border-color: rgba(78, 204, 163, 0.45);
}

/* ===== 分组框 ===== */
QGroupBox {
    font-weight: 700;
    font-size: 15px;
    color: #1b4332;
    border: 2px solid rgba(78, 204, 163, 0.3);
    border-radius: 12px;
    margin-top: 24px;
    padding: 20px 16px 16px 16px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.9), stop:1 rgba(240, 251, 246, 0.8));
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 18px;
    padding: 0 12px;
    margin-top: -8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0.15), stop:1 rgba(69, 179, 144, 0.15));
    border-radius: 8px;
    border: 1px solid rgba(78, 204, 163, 0.25);
}

/* ===== 标签 ===== */
QLabel {
    color: #1b4332;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

/* ===== 数字输入框 ===== */
QSpinBox {
    padding: 8px 14px;
    border: 2px solid rgba(78, 204, 163, 0.3);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.95);
    color: #1b4332;
    font-size: 14px;
    font-weight: 600;
    min-width: 120px;
    min-height: 36px;
}
QSpinBox:focus {
    border: 2px solid #4ecca3;
    background: rgba(255, 255, 255, 1);
}
QSpinBox:hover {
    border: 2px solid rgba(78, 204, 163, 0.5);
}
QSpinBox::up-button, 
QSpinBox::down-button {
    width: 24px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(78, 204, 163, 0.15), stop:1 rgba(69, 179, 144, 0.15));
    border: none;
    border-radius: 4px;
}
QSpinBox::up-button:hover, 
QSpinBox::down-button:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(78, 204, 163, 0.3), stop:1 rgba(69, 179, 144, 0.3));
}

/* ===== 滑块 ===== */
QSlider::groove:horizontal {
    height: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0.2), stop:1 rgba(69, 179, 144, 0.2));
    border-radius: 4px;
}
QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4ecca3, stop:1 #45b390);
    border: 2px solid #5ddbb9;
    border-radius: 10px;
    margin: -6px 0;
}
QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #5ddbb9, stop:1 #4ecca3);
}

/* ===== 复选框 ===== */
QCheckBox {
    font-size: 14px;
    color: #1b4332;
    font-weight: 600;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(78, 204, 163, 0.4);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.9);
}
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4ecca3, stop:1 #45b390);
    border-color: #4ecca3;
}
QCheckBox::indicator:hover {
    border-color: rgba(78, 204, 163, 0.6);
}

/* ===== 按钮 ===== */
QPushButton {
    padding: 10px 28px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.5px;
}
#saveButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4ecca3, stop:1 #45b390);
    color: white;
    border: 2px solid #4ecca3;
}
#saveButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5ddbb9, stop:1 #4ecca3);
    border-color: #5ddbb9;
}
#saveButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3db38a, stop:1 #349571);
}
#cancelButton {
    background: rgba(255, 255, 255, 0.9);
    color: #1b4332;
    border: 2px solid rgba(78, 204, 163, 0.35);
}
#cancelButton:hover {
    background: rgba(255, 255, 255, 1);
    border-color: rgba(78, 204, 163, 0.55);
}
#cancelButton:pressed {
    background: rgba(255, 255, 255, 0.75);
    border-color: rgba(78, 204, 163, 0.25);
}
