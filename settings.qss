/* ===== 对话框整体背景 ===== */
QDialog#SettingsDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f5fcf8, stop:0.5 #f0fbf6, stop:1 #ffffff);
}

/* ===== 选项卡面板 ===== */
QTabWidget::pane {
    border: 2px solid rgba(78, 204, 163, 0.3);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.96);
    top: -2px;
}
QTabWidget > QWidget {
    background: rgba(255, 255, 255, 0.96);
    border-radius: 12px;
}
QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f6f8fa, stop:1 #eef2f5);
    border: 1.5px solid rgba(78, 204, 163, 0.25);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    margin-right: 4px;
    color: #406b52;
    font-weight: 600;
    font-size: 13px;
}
QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(78, 204, 163, 0.4);
    border-bottom: 2px solid #ffffff;
    color: #1b4332;
    font-weight: 700;
}
QTabBar::tab:hover {
    background: #ffffff;
    border-color: rgba(78, 204, 163, 0.45);
}

/* ===== 分组框 ===== */
QGroupBox {
    font-weight: 700;
    font-size: 15px;
    color: #1b4332;
    border: 2px solid rgba(78, 204, 163, 0.3);
    border-radius: 12px;
    margin-top: 24px;
    padding: 20px 16px 16px 16px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.9), stop:1 rgba(240, 251, 246, 0.8));
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 18px;
    padding: 0 12px;
    margin-top: -8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0.15), stop:1 rgba(69, 179, 144, 0.15));
    border-radius: 8px;
    border: 1px solid rgba(78, 204, 163, 0.25);
}

/* ===== 标签 ===== */
QLabel {
    color: #1b4332;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

/* ===== 数字输入框 ===== */
QSpinBox {
    padding: 6px 30px 6px 12px;
    border: 2px solid rgba(78, 204, 163, 0.35);
    border-radius: 8px;
    background: #ffffff;
    color: #1b4332;
    font-size: 14px;
    font-weight: 600;
    min-height: 32px;
    max-width: 140px;
}
QSpinBox:focus {
    border: 2px solid #4ecca3;
    background: #ffffff;
}
QSpinBox:hover {
    border: 2px solid rgba(78, 204, 163, 0.55);
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    height: 18px;
    border-left: 1px solid rgba(78, 204, 163, 0.3);
    border-bottom: 0.5px solid rgba(78, 204, 163, 0.3);
    border-top-right-radius: 7px;
    background: rgba(78, 204, 163, 0.12);
}
QSpinBox::up-button:hover {
    background: rgba(78, 204, 163, 0.3);
}
QSpinBox::up-arrow {
    image: url({ASSET_DIR}/arrow_up.png);
    width: 10px;
    height: 10px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    height: 18px;
    border-left: 1px solid rgba(78, 204, 163, 0.3);
    border-top: 0.5px solid rgba(78, 204, 163, 0.3);
    border-bottom-right-radius: 7px;
    background: rgba(78, 204, 163, 0.12);
}
QSpinBox::down-button:hover {
    background: rgba(78, 204, 163, 0.3);
}
QSpinBox::down-arrow {
    image: url({ASSET_DIR}/arrow_down.png);
    width: 10px;
    height: 10px;
}

/* ===== 滑块 ===== */
QSlider::groove:horizontal {
    height: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 204, 163, 0.2), stop:1 rgba(69, 179, 144, 0.2));
    border-radius: 4px;
}
QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4ecca3, stop:1 #45b390);
    border: 2px solid #5ddbb9;
    border-radius: 10px;
    margin: -6px 0;
}
QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #5ddbb9, stop:1 #4ecca3);
}

/* ===== 复选框 ===== */
QCheckBox {
    font-size: 14px;
    color: #1b4332;
    font-weight: 600;
    spacing: 10px;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(78, 204, 163, 0.5);
    border-radius: 6px;
    background: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #4ecca3;
}
QCheckBox::indicator:checked {
    image: url({ASSET_DIR}/checkbox_checked.png);
    border-color: #4ecca3;
}

/* ===== 设置分组卡片 ===== */
QWidget#settingsCard {
    background-color: #ffffff;
    border: 1.5px solid rgba(78, 204, 163, 0.35);
    border-radius: 10px;
}

/* ===== 分组与行标签样式 ===== */
QLabel#sectionHeader {
    font-size: 13px;
    font-weight: 700;
    color: #2d6a4f;
    padding: 2px 2px;
}
QLabel#rowTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1b4332;
}
QLabel#rowDesc {
    font-size: 12px;
    color: #5c7065;
}

/* ===== 底部按钮 ===== */
QPushButton {
    padding: 8px 24px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
    min-height: 22px;
}
#previewSoundButton {
    padding: 2px 10px;
    min-width: 50px;
    max-width: 70px;
    min-height: 24px;
    background-color: rgba(78, 204, 163, 0.15);
    color: #1b4332;
    border: 1.5px solid rgba(78, 204, 163, 0.4);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
}
#previewSoundButton:hover {
    background-color: rgba(78, 204, 163, 0.3);
    border-color: #4ecca3;
}
#previewSoundButton:pressed {
    background-color: rgba(78, 204, 163, 0.5);
}
#previewSoundButton:disabled {
    background-color: #f0f0f0;
    color: #a0a0a0;
    border-color: #dcdcdc;
}
#saveButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #4ecca3, stop:1 #45b390);
    color: white;
    border: none;
}
#saveButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #5ddbb9, stop:1 #4ecca3);
}
#saveButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3db38a, stop:1 #349571);
}
#cancelButton {
    background-color: #f6f8fa;
    color: #24292f;
    border: 1.5px solid #d0d7de;
}
#cancelButton:hover {
    background-color: #e8eaed;
    border-color: #afb8c1;
}
#cancelButton:pressed {
    background-color: #d0d7de;
}

/* ===== 弹窗与消息提示框 (QMessageBox) ===== */
QMessageBox {
    background-color: #ffffff;
    border: 2px solid #4ecca3;
    border-radius: 14px;
}
QMessageBox QLabel {
    color: #1b4332;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    background: transparent;
    min-height: 40px;
    padding: 6px;
}
QMessageBox QPushButton {
    padding: 8px 24px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4ecca3, stop:1 #45b390);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    min-width: 75px;
    min-height: 24px;
}
QMessageBox QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5ddbb9, stop:1 #4ecca3);
}
QMessageBox QPushButton:pressed {
    background: #3db38a;
}

/* ===== 通用工具提示 (QToolTip) ===== */
QToolTip {
    background-color: #1b4332;
    color: #ffffff;
    border: 1.5px solid #4ecca3;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-family: 'Microsoft YaHei UI', 'Segoe UI', sans-serif;
    font-weight: 500;
}
