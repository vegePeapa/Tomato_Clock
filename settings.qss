/* ===== 设置界面极简现代卡片样式 (匹配参考图温暖精致风格) ===== */

/* 对话框整体背景 */
QDialog#SettingsDialog {
    background-color: #faf6f5;
    font-family: 'Microsoft YaHei UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
    color: #2b2523;
}

/* ===== 分段胶囊选项卡 (Capsule Tabs) ===== */
QTabWidget::pane {
    border: none;
    background: transparent;
    padding-top: 10px;
}
QTabWidget > QWidget {
    background: transparent;
}
QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background: #f2ece8;
    border: 1px solid #e8dfd8;
    border-radius: 17px;
    padding: 7px 18px;
    margin-right: 8px;
    color: #756a65;
    font-size: 13px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: #ffffff;
    border: 1.5px solid #ff7562;
    color: #ff5b48;
    font-weight: 700;
}
QTabBar::tab:hover:!selected {
    background: #faf6f4;
    border-color: #e0d5ce;
    color: #2b2523;
}

/* ===== 设置分组卡片 (纯白卡片 + 极细柔和边框) ===== */
QWidget#settingsCard {
    background-color: #ffffff;
    border: 1px solid #f0ece9;
    border-radius: 16px;
}

/* 分组标题与文字 */
QLabel#sectionHeader {
    font-size: 13px;
    font-weight: 700;
    color: #ff5b48;
    padding: 4px 2px;
}
QLabel#rowTitle {
    font-size: 14px;
    font-weight: 600;
    color: #2b2523;
    background: transparent;
}
QLabel#rowDesc {
    font-size: 12px;
    color: #8c827e;
    background: transparent;
}
QLabel {
    color: #2b2523;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

/* ===== 数字微调输入框 (QSpinBox) ===== */
QSpinBox {
    padding: 6px 30px 6px 12px;
    border: 1px solid #e5dfda;
    border-radius: 10px;
    background-color: #faf8f7;
    color: #2b2523;
    font-size: 14px;
    font-weight: 600;
    min-height: 32px;
    max-width: 130px;
}
QSpinBox:hover {
    border-color: #ffb8b0;
    background-color: #ffffff;
}
QSpinBox:focus {
    border: 1.5px solid #ff5b48;
    background-color: #ffffff;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    height: 16px;
    border: none;
    background: transparent;
    border-top-right-radius: 9px;
}
QSpinBox::up-button:hover {
    background: #eee8e4;
}
QSpinBox::up-arrow {
    image: url({ASSET_DIR}/assets/arrow_up.svg);
    width: 12px;
    height: 12px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    height: 16px;
    border: none;
    background: transparent;
    border-bottom-right-radius: 9px;
}
QSpinBox::down-button:hover {
    background: #eee8e4;
}
QSpinBox::down-arrow {
    image: url({ASSET_DIR}/assets/arrow_down.svg);
    width: 12px;
    height: 12px;
}

/* ===== 声音滑块 (QSlider) ===== */
QSlider::groove:horizontal {
    height: 6px;
    background: #eee8e4;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    height: 6px;
    background: #ff6552;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    background: #ff5b48;
    border: 2px solid #ffffff;
    border-radius: 9px;
    margin: -6px 0;
}
QSlider::handle:horizontal:hover {
    background: #ff7867;
}

/* ===== 复选框 (QCheckBox) ===== */
QCheckBox {
    font-size: 14px;
    color: #2b2523;
    font-weight: 600;
    spacing: 12px;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    image: url({ASSET_DIR}/assets/checkbox_unchecked.svg);
    background: transparent;
    border: none;
}
QCheckBox::indicator:hover {
    image: url({ASSET_DIR}/assets/checkbox_hover.svg);
}
QCheckBox::indicator:checked {
    image: url({ASSET_DIR}/assets/checkbox_checked.svg);
}

/* ===== 试听按钮 ===== */
#previewSoundButton {
    padding: 4px 14px;
    min-width: 60px;
    min-height: 28px;
    background-color: #fdebed;
    color: #ff5b48;
    border: 1px solid #fcdada;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
}
#previewSoundButton:hover {
    background-color: #fce2e5;
    border-color: #f8c2c7;
}
#previewSoundButton:pressed {
    background-color: #fad5d9;
}
#previewSoundButton:disabled {
    background-color: #f2f2f2;
    color: #b5b5b5;
    border-color: #e5e5e5;
}

/* ===== 底部保存/取消按钮 ===== */
QPushButton#saveButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ff6552, stop:1 #ee4a39);
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    min-height: 36px;
}
QPushButton#saveButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ff7867, stop:1 #f05747);
}
QPushButton#saveButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #d93d2c, stop:1 #c23323);
}

QPushButton#cancelButton {
    background-color: #ffffff;
    border: 1.5px solid #eae6e6;
    border-radius: 12px;
    color: #444444;
    font-size: 14px;
    font-weight: 600;
    min-height: 36px;
}
QPushButton#cancelButton:hover {
    background-color: #fdfdfd;
    border-color: #dad5d5;
}
QPushButton#cancelButton:pressed {
    background-color: #f2f2f2;
}
